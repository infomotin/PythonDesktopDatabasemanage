def infer_quality_score_complete(df: pd.DataFrame) -> float:
    if df is None or df.empty:
        return float(0)
    score = 0.0
    n_rows = len(df)
    if n_rows < 10:
        score += n_rows / 10 * 20
    else:
        score += 20
    null_pct = (df.isnull().mean().mean() * 100)
    score += max(0, 30 - null_pct * 0.5)
    dups = df.duplicated().sum()
    dup_pct = dups / n_rows
    score += max(0, 30 - dup_pct * 30)
    return float(min(score, 100))


def infer_quality_score(df: pd.DataFrame) -> float:
    if df is None or df.empty:
        return 0.0
    return float(infer_quality_score_complete(df))


def rank_analytics_columns(
        df: pd.DataFrame, dtypes: dict, ranked_columns: list = None, ranking_type: str = "variance", min_score: float = 0.1
) -> list[str]:
    if df is None or df.empty:
        return []
    num = df.select_dtypes(include="number")
    if num.empty:
        return df.columns.tolist()
    ranked_columns = ranked_columns or df.columns.tolist()
    score_map = {col: (num[col].std() if col in num.columns else 0) for col in ranked_columns}
    scores = [score_map.get(c, 0) for c in ranked_columns]
    if not scores:
        return df.columns.tolist()
    max_s = max(scores)
    if max_s == 0:
        return [c for c in ranked_columns if c in df.columns]
    return [c for c, s in zip(ranked_columns, scores) if s >= max_s * min_score and c in df.columns] or df.columns.tolist()


def get_col_meta(col, dtypes=None):
    if dtypes and col in dtypes:
        t = str(dtypes[col]).lower()
        if "int" in t or "float" in t:
            return "numeric"
        if "datetime" in t or "date" in t:
            return "datetime"
        return "string"
    return "string"


