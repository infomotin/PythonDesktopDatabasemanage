SECRET_KEY=django-insecure-kilo-dbms-2024-secure-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

DBMS_NAME=DBMS Pro
DBMS_VERSION=1.0.0
DBMS_DESCRIPTION=Professional Database Management System
ENCRYPTION_KEY=kilo-dbms-encryption-key-2024

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@dbmspro.com

STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Subscription tiers
TIER_FREE_NAME=Free
TIER_FREE_PRICE=0
TIER_FREE_DATABASES=1
TIER_FREE_TABLES=5
TIER_FREE_STORAGE_MB=10

TIER_PRO_NAME=Pro
TIER_PRO_PRICE=29
TIER_PRO_DATABASES=10
TIER_PRO_TABLES=100
TIER_PRO_STORAGE_MB=5000

TIER_ENTERPRISE_NAME=Enterprise
TIER_ENTERPRISE_PRICE=99
TIER_ENTERPRISE_DATABASES=-1  # unlimited
TIER_ENTERPRISE_TABLES=-1  # unlimited
TIER_ENTERPRISE_STORAGE_MB=100000  # 100GB
